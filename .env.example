# ============================================================================
# Sistema Café — Environment Variables Template (.env.example)
# ============================================================================

# Google Gemini AI API Key (Obligatorio para el agente Sommelier AI)
# Obtén tu clave en Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=tu_api_key_aqui
GEMINI_MODEL=gemini-flash-lite-latest

# PostgreSQL Database Configuration
POSTGRES_DB=sistemacafe
POSTGRES_USER=coffeeuser
POSTGRES_PASSWORD=coffeepassword
POSTGRES_PORT=5432

# Redis Cache & 2FA Store
REDIS_PORT=6379

# Spring Boot Core Backend
BACKEND_PORT=8088
JWT_SECRET=tu_jwt_secret_hex_64_caracteres_aqui

# Spring AI MCP Server
MCP_SERVER_PORT=8001

# FastAPI MCP Client & Agent
MCP_CLIENT_PORT=8000

# Frontend Web Application
FRONTEND_PORT=3000
